 "staff": [
  {
   "id": "str",
   "name": "James Richard Rogers III (Trey)",
   "ini": "TR",
   "role": "Senior Pastor",
   "phone": "(252) 221-4133",
   "email": "trogers@rhbce.org",
   "bio": "Pastor Trey comes from the mountains of Western North Carolina, where faith and ministry were part of his life from an early age. A fourth-generation minister, he sensed God’s call to preach at 14, was licensed in 2011 and ordained in 2016.\n\nHe holds a B.A. in Religious Studies from Young Harris College, where he met his wife, Julianna. They married in 2018. “Mrs. Juli” teaches 3rd grade at D.F. Walker Elementary School.\n\nOver 15 years he has served in pastoral, youth and children’s, and music ministry. He came to Rocky Hock as Associate Pastor of Youth and Children in 2024 and was called as Senior Pastor in March 2026.",
   "photo": ""
  },
  {
   "id": "sch",
   "name": "Dr. Cache’ Hapner",
   "ini": "CH",
   "role": "Director of Family & Children’s Ministries",
   "phone": "(252) 221-4133",
   "email": "chapner@rhbce.org",
   "bio": "Dr. Hapner is an educator, mentor and retired U.S. Navy Chief Petty Officer with more than 20 years of experience teaching, training and building teams. In the Navy she held leadership roles including Instructor and Senior Training Leader.\n\nShe holds a Doctor of Education in Organizational Leadership and teaches at College of the Albemarle, where she develops curriculum and mentors students. Her community service includes Drug Education for Youth (DEFY), school volunteer programs, GED instruction, and support for senior citizens and homeless veterans, earning her two Military Outstanding Volunteer Service Medals. She and her husband, Dan, have three children, and the family has served at Rocky Hock through Vacation Bible School, Hand Bells and more.\n\nRaised in the Baptist church, she accepted Christ at 13. She joined the staff in October 2026. Her heart is to partner with parents and families so every child comes to know Jesus, grows as His disciple, and feels safe, loved and rooted in the church family.",
   "photo": ""
  },
  {
   "id": "slb",
   "name": "Linda Bunch",
   "ini": "LB",
   "role": "Administrative Assistant",
   "phone": "(252) 221-4133",
   "email": "lbunch@rhbce.org",
   "bio": "Linda joined the staff in 2007. She grew up in Perquimans County and has lived in Rocky Hock for more than three decades. She sees her work as a calling as much as a job.",
   "photo": ""
  },
  {
   "id": "sdl",
   "name": "Deborah Long",
   "ini": "DL",
   "role": "Custodian",
   "phone": "(252) 221-4133",
   "email": "",
   "bio": "Deborah has served full-time since 2015. She has lived in Rocky Hock most of her life and has been a member since she was 12.",
   "photo": ""
  }
 ],
